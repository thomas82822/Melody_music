# Melody Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Telegram API (from my.telegram.org)
API_ID=
API_HASH=

# Bot token (from @BotFather)
BOT_TOKEN=

# MongoDB Atlas connection string
MONGO_DB_URI=

# Pyrogram string session of assistant/userbot account
STRING_SESSION=

# Your Telegram numeric user ID (owner)
OWNER_ID=

# Alias shown in play cards — NOT your real name
OWNER_NAME=Maestro

# Private group ID for error logs (e.g. -1001234567890)
LOG_GROUP_ID=

# Base64-encoded YouTube cookies.txt (optional, for age-restricted content)
YT_COOKIES=

# Genius API token (from genius.com/api-clients)
GENIUS_API_TOKEN=

# Maximum song duration in seconds. 0 = UNLIMITED (Melody plays full songs,
# mixes, even long live sets, no cutoff). Set a positive number only if you
# deliberately want a cap again.
MAX_DURATION=0

# Enable autoplay by default (true/false)
AUTOPLAY=true

# Your bot's username (e.g. @YourMelodyBot)
BOT_USERNAME=

# HTTPS URL where web_app/index.html is hosted (GitHub Pages / Vercel)
WEBAPP_URL=

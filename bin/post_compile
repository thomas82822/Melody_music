#!/usr/bin/env bash
# Heroku Python buildpack runs this after pip install.
#
# Real root cause of "Sign in to confirm you're not a bot" / "Requested
# format is not available" on Heroku: YouTube now requires a Proof-of-Origin
# (PO) token for essentially every client, and Heroku's dyno IPs sit in
# well-known cloud/datacenter ranges that get flagged hardest. Cookies alone
# do not fix this. A paid proxy can mask the IP, but the actual fix yt-dlp
# recommends is generating a valid PO token — that's what bgutil provides,
# for free, self-hosted inside the dyno.
#
# This installs:
#   1. Deno — the JS runtime yt-dlp's YouTube extractor needs to solve the
#      player challenge and to run bgutil's token-generator script.
#   2. bgutil-ytdlp-pot-provider — a yt-dlp plugin + Deno-based local script
#      that generates PO tokens on demand. Loaded via sys.path in
#      melody/core/ytdl.py.

set -e

BUILD_DIR=${1:-${BUILD_DIR:-$(pwd)}}

# ── Deno ─────────────────────────────────────────────────────────────────
DENO_DIR="$BUILD_DIR/vendor/deno/bin"
DENO_TMP="$BUILD_DIR/vendor/deno_tmp"
mkdir -p "$DENO_DIR" "$DENO_TMP"

if command -v deno >/dev/null 2>&1; then
  echo "-----> Deno already available: $(command -v deno)"
else
  echo "-----> Installing Deno for yt-dlp YouTube challenge solving"
  DENO_URL="https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip"
  if curl -fsSL --retry 3 --retry-delay 3 "$DENO_URL" -o "$DENO_TMP/deno.zip" \
    && python - "$DENO_TMP/deno.zip" "$DENO_DIR" <<'PY'
import sys
import zipfile

with zipfile.ZipFile(sys.argv[1]) as archive:
    archive.extract("deno", sys.argv[2])
PY
  then
    chmod +x "$DENO_DIR/deno"
    echo "       Deno installed at $DENO_DIR/deno ✅"
  else
    echo "       ⚠️ Deno download failed; yt-dlp will try the host runtime"
  fi
fi
rm -rf "$DENO_TMP"

if [ -x "$DENO_DIR/deno" ]; then
  "$DENO_DIR/deno" --version | head -3
elif command -v deno >/dev/null 2>&1; then
  deno --version | head -3
fi

# ── bgutil PO-token provider ────────────────────────────────────────────
BGUTIL_VERSION="1.3.1"
BGUTIL_HOME="$BUILD_DIR/vendor/bgutil-ytdlp-pot-provider"
BGUTIL_TMP="$BUILD_DIR/vendor/bgutil_tmp"
BGUTIL_ZIP="$BGUTIL_TMP/bgutil.zip"
# The tagged source archive (not the release asset) also contains
# server/src/generate_once.ts plus the locked Deno/npm dependency manifests.
BGUTIL_URL="https://github.com/Brainicism/bgutil-ytdlp-pot-provider/archive/refs/tags/${BGUTIL_VERSION}.zip"

rm -rf "$BGUTIL_HOME" "$BGUTIL_TMP"
mkdir -p "$BGUTIL_HOME" "$BGUTIL_TMP"
echo "-----> Installing bgutil yt-dlp PO-token provider v${BGUTIL_VERSION}"

if curl -fsSL --retry 3 --retry-delay 3 "$BGUTIL_URL" -o "$BGUTIL_ZIP" \
  && python - "$BGUTIL_ZIP" "$BGUTIL_TMP/extracted" <<'PY'
import sys
import zipfile

archive_path, output_dir = sys.argv[1:3]
with zipfile.ZipFile(archive_path) as archive:
    archive.extractall(output_dir)
PY
then
  BGUTIL_ROOT=$(find "$BGUTIL_TMP/extracted" -mindepth 1 -maxdepth 1 -type d -print -quit)
  if [ -d "$BGUTIL_ROOT/plugin" ] && [ -f "$BGUTIL_ROOT/server/src/generate_once.ts" ]; then
    cp -R "$BGUTIL_ROOT/plugin" "$BGUTIL_HOME/plugin"
    cp -R "$BGUTIL_ROOT/server" "$BGUTIL_HOME/server"
  else
    echo "       ⚠️ bgutil archive layout is unexpected; provider will remain inactive"
    rm -rf "$BGUTIL_HOME"
  fi

  if [ -x "$DENO_DIR/deno" ]; then
    BGUTIL_DENO="$DENO_DIR/deno"
  else
    BGUTIL_DENO="$(command -v deno || true)"
  fi
  if [ -n "$BGUTIL_DENO" ] && [ -f "$BGUTIL_HOME/server/src/generate_once.ts" ]; then
    if (
      cd "$BGUTIL_HOME/server"
      "$BGUTIL_DENO" install --allow-scripts=npm:canvas --frozen
    ); then
      mkdir -p "$BGUTIL_HOME/cache"
      XDG_CACHE_HOME="$BGUTIL_HOME/cache" \
        "$BGUTIL_DENO" run \
          --allow-env \
          --allow-net \
          "--allow-ffi=$BGUTIL_HOME/server/node_modules" \
          "--allow-write=$BGUTIL_HOME/cache" \
          "--allow-read=$BGUTIL_HOME/cache,$BGUTIL_HOME/server/node_modules" \
          "$BGUTIL_HOME/server/src/generate_once.ts" --version
      echo "       bgutil plugin + Deno provider installed ✅"
    else
      echo "       ⚠️ bgutil Deno dependency install failed; built-in yt-dlp providers remain available"
    fi
  else
    echo "       ⚠️ Deno unavailable; bgutil plugin will remain inactive"
  fi
else
  echo "       ⚠️ bgutil download failed; yt-dlp will use its built-in providers"
fi

rm -rf "$BGUTIL_TMP"

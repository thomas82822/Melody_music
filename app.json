{
  "name": "MelodiXMusicBot",
  "description": "𝙈𝙚𝙡𝙤𝙙𝙞𝙓 🎧 — High quality Telegram Group Calls music bot. YouTube-only with cookie support. Built with Pyrogram and Py-TgCalls.",
  "logo": "https://telegra.ph/file/c0e014ff34f34d1056627.png",
  "keywords": [
    "python3", "telegram", "music-bot", "melodix",
    "MelodiXMusicBot", "telegram-bot", "pyrogram",
    "pytgcalls", "youtube", "voice-chat"
  ],
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Get from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "API_HASH": {
      "description": "Get from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Get from @BotFather on Telegram",
      "value": "",
      "required": true
    },
    "MONGO_DB_URI": {
      "description": "MongoDB URI from https://cloud.mongodb.com",
      "value": "",
      "required": true
    },
    "LOG_GROUP_ID": {
      "description": "Your private log group chat ID (add bot as admin with full rights). Must be a group, not a channel.",
      "value": "",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID. Multiple IDs separated by space.",
      "value": "",
      "required": true
    },
    "MUSIC_BOT_NAME": {
      "description": "Name for your music bot (use ASCII only, e.g. MelodiX)",
      "value": "MelodiX",
      "required": true
    },
    "STRING1": {
      "description": "Pyrogram String Session for Assistant 1. Get from @StringFatherBot. At least one is required.",
      "value": "",
      "required": true
    },
    "STRING2": {
      "description": "Pyrogram String Session for Assistant 2 (optional)",
      "value": "",
      "required": false
    },
    "STRING3": {
      "description": "Pyrogram String Session for Assistant 3 (optional)",
      "value": "",
      "required": false
    },
    "STRING4": {
      "description": "Pyrogram String Session for Assistant 4 (optional)",
      "value": "",
      "required": false
    },
    "STRING5": {
      "description": "Pyrogram String Session for Assistant 5 (optional)",
      "value": "",
      "required": false
    },
    "COOKIES": {
      "description": "YouTube cookies in Netscape format (cookies.txt). Export using 'Get cookies.txt LOCALLY' browser extension while logged into YouTube. Fixes age-restriction and bot-detection errors.",
      "value": "",
      "required": false
    },
    "HEROKU_API_KEY": {
      "description": "Your Heroku account API key from https://dashboard.heroku.com/account",
      "value": "",
      "required": false
    },
    "HEROKU_APP_NAME": {
      "description": "Your Heroku app name (same as what you deploy this as)",
      "value": "",
      "required": false
    },
    "UPSTREAM_REPO": {
      "description": "Your fork/repo URL (leave default if unsure)",
      "value": "https://github.com/thomas82822/Melody_music",
      "required": true
    },
    "UPSTREAM_BRANCH": {
      "description": "Upstream repo branch name",
      "value": "master",
      "required": true
    },
    "DURATION_LIMIT": {
      "description": "Max song duration in minutes (default 60)",
      "value": "60",
      "required": false
    },
    "AUTO_LEAVING_ASSISTANT": {
      "description": "Set True if you want assistant to auto-leave chats after a while",
      "value": "True",
      "required": false
    },
    "SUPPORT_CHANNEL": {
      "description": "Your support channel link",
      "value": "https://t.me/MelodiXMusic_Bot",
      "required": false
    },
    "SUPPORT_GROUP": {
      "description": "Your support group link",
      "value": "https://t.me/MelodiXMusic_Bot",
      "required": false
    }
  },
  "buildpacks": [
    { "url": "heroku/python" },
    { "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git" }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
